# Copy to .env for local development: cp .env.example .env
# In production, set real environment variables instead; .env is optional.
#
# Any config key can be overridden as UPPER_SNAKE_CASE, e.g.
#   app.shutdowntimeout -> APP_SHUTDOWNTIMEOUT
#   redis.password      -> REDIS_PASSWORD

# Selects the override file in ./config (dev -> config/dev.yaml, prod -> config/prod.yaml)
APP_ENV=dev

# Add your adapters' secrets here, e.g.
# REDIS_PASSWORD=change-me
# MINIO_SECRETKEY=change-me
